#!/bin/bash
set -e

dnf install -y python3 python3-pip nginx

mkdir -p /opt/dr-app

cat > /opt/dr-app/requirements.txt <<'REQ'
flask==3.0.3
gunicorn==22.0.0
pymysql==1.1.1
REQ

cat > /opt/dr-app/app.py <<'PY'
import os
import time

import pymysql
from flask import Flask, jsonify, request
from pymysql.cursors import DictCursor

app = Flask(__name__)

DB_HOST = os.environ.get("DB_HOST", "localhost")
DB_NAME = os.environ.get("DB_NAME", "appdb")
DB_USER = os.environ.get("DB_USER", "admin")
DB_PASSWORD = os.environ.get("DB_PASSWORD", "")


def get_connection(retries=25, delay=5):
    last_exception = None
    for _ in range(retries):
        try:
            return pymysql.connect(
                host=DB_HOST,
                user=DB_USER,
                password=DB_PASSWORD,
                database=DB_NAME,
                cursorclass=DictCursor,
                autocommit=True,
            )
        except Exception as exc:
            last_exception = exc
            time.sleep(delay)
    raise last_exception


def ensure_table(connection):
    with connection.cursor() as cursor:
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS personas (
              id INT NOT NULL AUTO_INCREMENT,
              nombre VARCHAR(100) NOT NULL,
              edad INT NOT NULL,
              PRIMARY KEY (id)
            )
            """
        )


@app.route("/")
def index():
    return jsonify({"message": "DR app activa"}), 200


@app.route("/health")
def health():
    return jsonify({"status": "ok"}), 200


@app.route("/api/personas", methods=["GET"])
def list_personas():
    connection = get_connection()
    with connection:
        ensure_table(connection)
        with connection.cursor() as cursor:
            cursor.execute("SELECT id, nombre, edad FROM personas ORDER BY id")
            rows = cursor.fetchall()
    return jsonify(rows), 200


@app.route("/api/personas", methods=["POST"])
def create_persona():
    payload = request.get_json(silent=True) or {}
    nombre = payload.get("nombre")
    edad = payload.get("edad")
    persona_id = payload.get("id")

    if not nombre or edad is None:
        return jsonify({"error": "nombre y edad son obligatorios"}), 400

    connection = get_connection()
    with connection:
        ensure_table(connection)
        with connection.cursor() as cursor:
            if persona_id is None:
                cursor.execute(
                    "INSERT INTO personas (nombre, edad) VALUES (%s, %s)",
                    (nombre, int(edad)),
                )
                created_id = cursor.lastrowid
            else:
                cursor.execute(
                    "INSERT INTO personas (id, nombre, edad) VALUES (%s, %s, %s)",
                    (int(persona_id), nombre, int(edad)),
                )
                created_id = int(persona_id)

    return jsonify({"id": created_id, "nombre": nombre, "edad": int(edad)}), 201


@app.route("/api/personas/<int:persona_id>", methods=["PUT"])
def update_persona(persona_id):
    payload = request.get_json(silent=True) or {}
    nombre = payload.get("nombre")
    edad = payload.get("edad")

    if not nombre or edad is None:
        return jsonify({"error": "nombre y edad son obligatorios"}), 400

    connection = get_connection()
    with connection:
        ensure_table(connection)
        with connection.cursor() as cursor:
            cursor.execute(
                "UPDATE personas SET nombre = %s, edad = %s WHERE id = %s",
                (nombre, int(edad), persona_id),
            )
            if cursor.rowcount == 0:
                return jsonify({"error": "persona no encontrada"}), 404

    return jsonify({"id": persona_id, "nombre": nombre, "edad": int(edad)}), 200


@app.route("/api/personas/<int:persona_id>", methods=["DELETE"])
def delete_persona(persona_id):
    connection = get_connection()
    with connection:
        ensure_table(connection)
        with connection.cursor() as cursor:
            cursor.execute("DELETE FROM personas WHERE id = %s", (persona_id,))
            if cursor.rowcount == 0:
                return jsonify({"error": "persona no encontrada"}), 404

    return jsonify({"deleted": persona_id}), 200


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8000)
PY

cat > /etc/dr-app.env <<EOF
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
EOF

cat > /etc/systemd/system/dr-app.service <<'SERVICE'
[Unit]
Description=DR CRUD App (Gunicorn)
Wants=network-online.target
After=network-online.target

[Service]
User=root
WorkingDirectory=/opt/dr-app
EnvironmentFile=/etc/dr-app.env
ExecStart=/usr/bin/env python3 -m gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/welcome.conf
cat > /etc/nginx/conf.d/dr-app.conf <<'NGINX'
server {
    listen 80;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX

python3 -m pip install --no-cache-dir -r /opt/dr-app/requirements.txt

systemctl daemon-reload
systemctl enable dr-app
systemctl enable --now dr-app
systemctl enable --now nginx
systemctl restart nginx